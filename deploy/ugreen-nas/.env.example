# Copy to .env (same folder) and fill in. Never commit the real .env.

# Tailscale auth key: https://login.tailscale.com/admin/settings/keys
# (Reusable: off. Ephemeral: off. Pre-approved: on.) Only needed for the first start.
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Machine name on your tailnet, and your tailnet's DNS name
# (Tailscale admin -> DNS -> "Tailnet name", e.g. tail1234.ts.net).
TS_HOSTNAME=devco
TS_TAILNET=tail1234.ts.net

# Where the agents build apps, and where JiuwenSwarm keeps its config/state.
# UGREEN shared folders live under /volume1/<share>/... (or /volume2 ...).
DEVCO_PROJECTS_DIR=/volume1/docker/devco/projects
DEVCO_DATA_DIR=/volume1/docker/devco/data
